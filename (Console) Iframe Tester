window.addEventListener('message', function(event) {
    var origin = event.origin; 
    var data = event.data; 

    console.log('Origin: ', origin);
    console.log('Data: ', data);

    window.dataLayer = window.dataLayer || [];
    dataLayer.push({
        event: 'postMessage', 
        origin: origin,
        data: data
    });
});
